{
  "name": "fanrio-cortex",
  "version": "1.0.0",
  "description": "SAP BDC Authorization Wizard — CAP backend + React frontend",
  "scripts": {
    "dev": "cds watch",
    "build": "npm run build --prefix app/catalog && cds build",
    "test": "cds test --profile test",
    "start": "cds serve"
  },
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10.0.3",
    "@sap/cds-dk": "^10.0.5",
    "@sap/hana-client": "^2.28.21",
    "@sap/xssec": "^4",
    "cors": "^2.8.6",
    "hdb": "^2.27.1"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.1",
    "concurrently": "^10.0.3",
    "@cap-js/sqlite": "^3.0.2",
    "puppeteer-core": "^25.3.0"
  },
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "kind": "sqlite"
        }
      },
      "html5-repo": true,
      "[production]": {
        "auth": "xsuaa"
      }
    },
    "[development]": {
      "requires": {
        "auth": {
          "kind": "mocked"
        }
      }
    },
    "[test]": {
      "features": {
        "in_memory_db": true
      },
      "requires": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        }
      }
    },
    "features": {
      "in_memory_db": false
    }
  }
}